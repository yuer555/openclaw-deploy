# OpenClaw 企业微信桥接网关 — 环境变量配置
#
# Agent 绑定关系存储在 SQLite 中，通过 manage-agent.py 管理
# 此文件仅配置 Gateway 自身运行参数

# 数据库路径
DB_PATH=/opt/openclaw/data/gateway/gateway.db

# Gateway 监听端口
GATEWAY_PORT=8000

# 与 openclaw 的通信协议（ws / sse / http）
OPENCLAW_PROTOCOL=ws

# openclaw 调用超时时间（秒，旧配置兼容字段，默认 180）
OPENCLAW_TIMEOUT=180

# 连接 openclaw 的超时与队列管控
# - 第 1 条消息：被动回复“已收到，处理中...”
# - 第 2 条消息：进入等待队列
# - 第 3 条消息：直接拒绝
OPENCLAW_CONNECT_TIMEOUT=10
OPENCLAW_WS_IDLE_TIMEOUT=30
OPENCLAW_WS_TOTAL_TIMEOUT=180
OPENCLAW_SSE_IDLE_TIMEOUT=30
OPENCLAW_SSE_TOTAL_TIMEOUT=180
OPENCLAW_HTTP_TIMEOUT=180

# Gateway 并发控制
MAX_GATEWAY_WORKERS=8
MAX_PER_USER_PENDING=1
MAX_QUEUE_WAIT_SECONDS=60

# Gateway 地址（manage-agent.py 用于通知重载；上传 Skill 也会基于它访问 Gateway）
GATEWAY_URL=http://localhost:8000

# 文件存储模式：local（默认）| s3
# 只影响“企业微信发来的文件”如何交给 Agent：
# - local：下发固定绝对路径 /app/shared/<agent_id>/...
# - s3：下发对象存储下载链接
# OpenClaw 主动上传文件/文本时，始终通过 S3 发布
FILE_STORAGE_MODE=local

# 预签名下载链接有效期（秒，默认 24h）
FILE_STORAGE_PRESIGN_EXPIRES=86400

# 企业微信 markdown.content 最大 20480 字节：
# Gateway 统一按 20000 字节阈值做截断回复

# Gateway 内部上传接口 Token（仅当使用 OpenClaw 上传 skill 时必填）
# 建议使用随机长字符串（例如 openssl rand -hex 32）
# 这组配置只影响 Agent 的“主动上传能力”，不影响企微来件的 local / s3 入站处理
# 注意：主动上传统一走 S3，因此启用该能力时必须同时配置下方 S3 参数
# `03-install-openclaw.sh` 会基于以下 Gateway 配置自动生成 Skill 运行时变量：
# - OPENCLAW_FILE_UPLOAD_GATEWAY_URL = GATEWAY_URL
# - OPENCLAW_FILE_UPLOAD_TOKEN       = FILE_UPLOAD_INTERNAL_TOKEN
# - OPENCLAW_FILE_UPLOAD_EXPIRES     = FILE_STORAGE_PRESIGN_EXPIRES
# 下发位置：
# - 非沙箱 Agent：写入 ~/.openclaw/.env（若 OpenClaw 已在运行，需重启）
# - 沙箱 Agent：写入 sandbox.docker.env（若 GATEWAY_URL 是 localhost/127.0.0.1，会自动改成 host.docker.internal，并补 host-gateway 映射；容器已存在时需 recreate）
FILE_UPLOAD_INTERNAL_TOKEN=

# OpenClaw skill 上传文件大小限制（字节，默认 50MB）
MAX_INTERNAL_UPLOAD_FILE_SIZE=52428800

# 存储对象 key 前缀（可选）
FILE_STORAGE_KEY_PREFIX=openclaw-gateway

# ========== S3 模式（FILE_STORAGE_MODE=s3）==========
# 自建 S3 兼容服务（参考你现有 Java 配置）推荐：
# - S3_SIGNATURE_VERSION=s3         (等价 S3SignerType)
# - S3_ADDRESSING_STYLE=path        (等价 withPathStyleAccess(true))
# - S3_ENDPOINT_URL=http://...      (等价 setEndpoint + HTTP)
#
# 【必填】
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 【建议】
S3_REGION=us-east-1
S3_SIGNATURE_VERSION=s3
S3_ADDRESSING_STYLE=path

# 【可选】
S3_KEY_PREFIX=openclaw-gateway
S3_SSE_MODE=
S3_SSE_KMS_KEY_ID=
