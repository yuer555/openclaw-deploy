#==============================================================================
# OpenClaw 本地测试环境变量配置
# 版本: V2.0（三层架构）
# 说明: 请复制此文件为 .env.local 并填入实际配置
#==============================================================================

#------------------------------------------------------------------------------
# 第三方 API 配置（通过 anthropic provider 代理）
#------------------------------------------------------------------------------
API_BASE_URL=https://your-api-provider.com/v1
API_KEY=your-api-key-here
MODEL_NAME=claude-sonnet-4-20250514

#------------------------------------------------------------------------------
# 企业微信配置（本地测试可选）
#------------------------------------------------------------------------------
# WECOM_CORP_ID=your_corp_id
# WECOM_AGENT_ID=your_agent_id
# WECOM_SECRET=your_secret
# WECOM_TOKEN=your_token
# WECOM_ENCODING_AES_KEY=your_encoding_aes_key

#------------------------------------------------------------------------------
# Telegram Bot 配置（本地测试可选）
#------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_MODE=polling

#------------------------------------------------------------------------------
# 虚拟员工容器 URL（本地 localhost + 端口映射）
#------------------------------------------------------------------------------
AGENT_OPERATION_URL=http://localhost:18791
AGENT_PRODUCT_URL=http://localhost:18792
AGENT_DEVELOPMENT_URL=http://localhost:18793
AGENT_TESTING_URL=http://localhost:18794
AGENT_SERVICE_URL=http://localhost:18795
