#==============================================================================
# OpenClaw 本地测试环境变量配置
# 版本: V2.0（三层架构）
# 说明: 请复制此文件为 .env.local 并填入实际配置
#==============================================================================

#------------------------------------------------------------------------------
# API 配置（二选一）
#------------------------------------------------------------------------------
# 方式一：OpenAI 兼容 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方式二：第三方 API（API_KEY 会同时映射为 ANTHROPIC_API_KEY）
API_BASE_URL=https://your-api-provider.com/v1
API_KEY=your-api-key-here
MODEL_NAME=claude-sonnet-4-20250514

#------------------------------------------------------------------------------
# 企业微信配置（本地测试可选，智能机器人回调加解密）
#------------------------------------------------------------------------------
# WECOM_TOKEN=your_token
# WECOM_ENCODING_AES_KEY=your_encoding_aes_key

#------------------------------------------------------------------------------
# OpenClaw 内部配置（一般使用默认值即可）
#------------------------------------------------------------------------------
# OPENCLAW_GATEWAY_URL=http://localhost:18789
# OPENCLAW_TIMEOUT=2700
# OPENCLAW_INTERNAL_TOKEN=openclaw-internal-secret
# DB_PATH=./data/gateway/gateway.db

#------------------------------------------------------------------------------
# 虚拟员工容器 URL（本地 localhost + 端口映射）
#------------------------------------------------------------------------------
AGENT_OPERATION_URL=http://localhost:18791
AGENT_PRODUCT_URL=http://localhost:18792
AGENT_DEVELOPMENT_URL=http://localhost:18793
AGENT_TESTING_URL=http://localhost:18794
AGENT_SERVICE_URL=http://localhost:18795

#------------------------------------------------------------------------------
# 共享文件目录（Gateway 下载文件保存位置，挂载到 Agent 容器）
# 本地默认使用项目目录下的 shared-files/
#------------------------------------------------------------------------------
# SHARED_FILES_BASE=./shared-files
# CONTAINER_FILES_BASE=/shared-files

#------------------------------------------------------------------------------
# 虚拟员工容器名称（一般使用默认值即可）
#------------------------------------------------------------------------------
# AGENT_OPERATION_CONTAINER=openclaw-agent-operation
# AGENT_PRODUCT_CONTAINER=openclaw-agent-product
# AGENT_DEVELOPMENT_CONTAINER=openclaw-agent-development
# AGENT_TESTING_CONTAINER=openclaw-agent-testing
# AGENT_SERVICE_CONTAINER=openclaw-agent-service
