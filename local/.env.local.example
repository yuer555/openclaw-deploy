#==============================================================================
# OpenClaw 本地测试环境变量配置
# 版本: V1.4
# 说明: 请复制此文件为 .env.local 并填入实际配置
#==============================================================================

#------------------------------------------------------------------------------
# 基础配置
#------------------------------------------------------------------------------
OPENCLAW_ENV=local
OPENCLAW_PORT=3000

#------------------------------------------------------------------------------
# AI 模型配置（至少配置一个）
#------------------------------------------------------------------------------

# 选项1: GitHub Copilot（推荐，免费）
# 1. 访问 https://github.com/settings/tokens
# 2. 生成新 Token（需要 copilot 权限）
# 3. 填入下方
GITHUB_TOKEN=your_github_token_here

# 选项2: OpenAI
# 1. 访问 https://platform.openai.com/api-keys
# 2. 创建新 API Key
# 3. 填入下方
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#------------------------------------------------------------------------------
# 数据库配置
#------------------------------------------------------------------------------
# 本地测试使用 SQLite（无需额外配置）
DATABASE_URL=sqlite:///data/openclaw.db

# 如需使用 PostgreSQL（可选）：
# DATABASE_URL=postgresql://username:password@localhost:5432/openclaw

#------------------------------------------------------------------------------
# 日志配置
#------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_DIR=/logs

#------------------------------------------------------------------------------
# 虚拟员工配置
#------------------------------------------------------------------------------
# 启用的虚拟员工角色（逗号分隔）
AGENTS_ENABLED=dispatcher,operation,product,development,testing,service

# 调度员配置
AGENT_DISPATCHER_NAME=智能调度员
AGENT_DISPATCHER_ROLE=dispatcher

# 运营专员配置
AGENT_OPERATION_NAME=运营专员
AGENT_OPERATION_ROLE=operation

# 产品经理配置
AGENT_PRODUCT_NAME=产品经理
AGENT_PRODUCT_ROLE=product

# 开发工程师配置
AGENT_DEVELOPMENT_NAME=开发工程师
AGENT_DEVELOPMENT_ROLE=development

# 测试工程师配置
AGENT_TESTING_NAME=测试工程师
AGENT_TESTING_ROLE=testing

# 客服专员配置
AGENT_SERVICE_NAME=客服专员
AGENT_SERVICE_ROLE=service

#------------------------------------------------------------------------------
# 安全配置
#------------------------------------------------------------------------------
# 本地测试使用简单密钥（生产环境必须修改！）
SECRET_KEY=local-secret-key-please-change-in-production

# 允许的源（CORS）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

#------------------------------------------------------------------------------
# 企业微信配置（本地测试可选）
#------------------------------------------------------------------------------
# 如需测试企业微信集成，请填写以下配置
# WECOM_CORP_ID=your_corp_id
# WECOM_AGENT_ID=your_agent_id
# WECOM_SECRET=your_secret
# WECOM_TOKEN=your_token
# WECOM_ENCODING_AES_KEY=your_encoding_aes_key

#------------------------------------------------------------------------------
# 调试配置
#------------------------------------------------------------------------------
# 详细日志
DEBUG=true
VERBOSE=true

# 关闭某些检查（仅用于测试）
SKIP_HEALTH_CHECK=false
SKIP_DB_MIGRATION=false

#------------------------------------------------------------------------------
# 性能配置
#------------------------------------------------------------------------------
# 最大并发任务数
MAX_CONCURRENT_TASKS=10

# 任务超时（秒）
TASK_TIMEOUT=300

# 缓存过期时间（秒）
CACHE_TTL=3600

#==============================================================================
# 填写说明
#==============================================================================
# 
# 1. 必填项：
#    - GITHUB_TOKEN 或 OPENAI_API_KEY（至少一个）
#
# 2. 可选项：
#    - 其他配置使用默认值即可
#    - 企业微信配置仅在需要测试集成时填写
#
# 3. 安全提示：
#    - 不要将此文件提交到 Git
#    - .env.local 已在 .gitignore 中
#    - 生产环境必须修改 SECRET_KEY
#
#==============================================================================
