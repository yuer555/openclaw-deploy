#==============================================================================
# OpenClaw 生产环境变量配置
# 版本: V3.0（多 Agent 配置化部署）
# 说明: 请复制此文件为 .env.prod 并填入实际配置
# ⚠️  注意: 此文件包含敏感信息，请勿提交到 Git！
#==============================================================================

#------------------------------------------------------------------------------
# API 配置（必填）
#------------------------------------------------------------------------------
# 方式一：OpenAI 兼容 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方式二：第三方流量池（支持任意模型，自定义 provider 名）
API_BASE_URL=https://your-api-provider.com/v1
API_KEY=your-api-key-here
MODEL_NAME=gpt-5.3-codex
# MODEL_PROVIDER: 自定义 provider 名（避免与 openclaw 内置 provider 冲突，可任意命名）
MODEL_PROVIDER=gmn
# MODEL_API: API 协议格式（默认 openai-responses）
# MODEL_API=openai-responses

#------------------------------------------------------------------------------
# 企业微信全局配置（必填）
#------------------------------------------------------------------------------
WECOM_CORP_ID=your_corp_id
WECOM_SECRET=your_secret
WECOM_AGENT_ID=your_agent_id

#------------------------------------------------------------------------------
# OpenClaw 内部配置（一般使用默认值即可）
#------------------------------------------------------------------------------
# OPENCLAW_TIMEOUT=2700
# OPENCLAW_INTERNAL_TOKEN=openclaw-internal-secret

# 通信协议：http / sse / ws / exec（默认 ws）
OPENCLAW_PROTOCOL=ws

#------------------------------------------------------------------------------
# Agent: operation（运营专员）
#------------------------------------------------------------------------------
AGENT_OPERATION_ENABLE=false
AGENT_OPERATION_WECOM_TOKEN=
AGENT_OPERATION_WECOM_ENCODING_AES_KEY=
AGENT_OPERATION_PORT=18791

#------------------------------------------------------------------------------
# Agent: product（产品经理）
#------------------------------------------------------------------------------
AGENT_PRODUCT_ENABLE=false
AGENT_PRODUCT_WECOM_TOKEN=
AGENT_PRODUCT_WECOM_ENCODING_AES_KEY=
AGENT_PRODUCT_PORT=18792

#------------------------------------------------------------------------------
# Agent: development（开发工程师）
#------------------------------------------------------------------------------
AGENT_DEVELOPMENT_ENABLE=true
AGENT_DEVELOPMENT_WECOM_TOKEN=your_dev_token
AGENT_DEVELOPMENT_WECOM_ENCODING_AES_KEY=your_dev_encoding_aes_key
AGENT_DEVELOPMENT_PORT=18793

#------------------------------------------------------------------------------
# Agent: testing（测试工程师）
#------------------------------------------------------------------------------
AGENT_TESTING_ENABLE=true
AGENT_TESTING_WECOM_TOKEN=your_test_token
AGENT_TESTING_WECOM_ENCODING_AES_KEY=your_test_encoding_aes_key
AGENT_TESTING_PORT=18794

#------------------------------------------------------------------------------
# Agent: service（客服专员）
#------------------------------------------------------------------------------
AGENT_SERVICE_ENABLE=false
AGENT_SERVICE_WECOM_TOKEN=
AGENT_SERVICE_WECOM_ENCODING_AES_KEY=
AGENT_SERVICE_PORT=18795

#------------------------------------------------------------------------------
# 共享文件目录（生产默认）
#------------------------------------------------------------------------------
SHARED_FILES_BASE=/opt/openclaw/shared-files
CONTAINER_FILES_BASE=/root/.openclaw/workspace/shared-files
DB_PATH=/opt/openclaw/data/gateway/gateway.db
