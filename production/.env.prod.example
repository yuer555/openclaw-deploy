#==============================================================================
# OpenClaw 生产环境变量配置
# 版本: V2.0（三层架构）
# 说明: 请复制此文件为 .env.prod 并填入实际配置
# ⚠️  注意: 此文件包含敏感信息，请勿提交到 Git！
#==============================================================================

#------------------------------------------------------------------------------
# API 配置（二选一）
#------------------------------------------------------------------------------
# 方式一：OpenAI 兼容 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方式二：第三方 API（API_KEY 会同时映射为 ANTHROPIC_API_KEY）
API_BASE_URL=https://your-api-provider.com/v1
API_KEY=your-api-key-here
MODEL_NAME=claude-sonnet-4-20250514

#------------------------------------------------------------------------------
# 企业微信配置（智能机器人回调加解密，生产必填）
#------------------------------------------------------------------------------
WECOM_TOKEN=your_token
WECOM_ENCODING_AES_KEY=your_encoding_aes_key

#------------------------------------------------------------------------------
# Telegram Bot 配置（可选）
#------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_MODE=polling

#------------------------------------------------------------------------------
# OpenClaw 内部配置（一般使用默认值即可）
#------------------------------------------------------------------------------
# OPENCLAW_GATEWAY_URL=http://localhost:18789
# OPENCLAW_TIMEOUT=2700
# OPENCLAW_INTERNAL_TOKEN=openclaw-internal-secret
# DB_PATH=/data/user_roles.db

#------------------------------------------------------------------------------
# 虚拟员工容器 URL（Docker 固定 IP，子网 172.20.0.0/16）
#------------------------------------------------------------------------------
AGENT_OPERATION_URL=http://172.20.0.11:18789
AGENT_PRODUCT_URL=http://172.20.0.12:18789
AGENT_DEVELOPMENT_URL=http://172.20.0.13:18789
AGENT_TESTING_URL=http://172.20.0.14:18789
AGENT_SERVICE_URL=http://172.20.0.15:18789

#------------------------------------------------------------------------------
# 虚拟员工容器名称（一般使用默认值即可）
#------------------------------------------------------------------------------
# AGENT_OPERATION_CONTAINER=openclaw-agent-operation
# AGENT_PRODUCT_CONTAINER=openclaw-agent-product
# AGENT_DEVELOPMENT_CONTAINER=openclaw-agent-development
# AGENT_TESTING_CONTAINER=openclaw-agent-testing
# AGENT_SERVICE_CONTAINER=openclaw-agent-service
