#==============================================================================
# OpenClaw 生产环境变量配置
# 版本: V1.4
# 说明: 请复制此文件为 .env.prod 并填入实际配置
# ⚠️  注意: 此文件包含敏感信息，请勿提交到 Git！
#==============================================================================

#------------------------------------------------------------------------------
# 基础配置
#------------------------------------------------------------------------------
OPENCLAW_ENV=production
OPENCLAW_PORT=3000

# 服务器域名（用于 SSL 配置）
DOMAIN=openclaw.yourdomain.com

#------------------------------------------------------------------------------
# AI 模型配置（必须配置一个）
#------------------------------------------------------------------------------

# 选项1: GitHub Copilot（推荐）
# 获取方式: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# 选项2: OpenAI
# 获取方式: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#------------------------------------------------------------------------------
# 数据库配置
#------------------------------------------------------------------------------
# 选项1: SQLite（默认，适合中小规模）
DATABASE_URL=sqlite:///data/openclaw.db

# 选项2: PostgreSQL（推荐大规模部署）
# DATABASE_URL=postgresql://openclaw:your_db_password@openclaw-database:5432/openclaw
# DB_NAME=openclaw
# DB_USER=openclaw
# DB_PASSWORD=your_strong_db_password_here

#------------------------------------------------------------------------------
# 安全配置（必须修改！）
#------------------------------------------------------------------------------
# 生成方式: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING_IN_PRODUCTION

# 允许的源（CORS）
ALLOWED_ORIGINS=https://openclaw.yourdomain.com

#------------------------------------------------------------------------------
# 企业微信配置（必填）
#------------------------------------------------------------------------------
# 企业 ID
WECOM_CORP_ID=your_corp_id

# 应用 ID
WECOM_AGENT_ID=your_agent_id

# 应用 Secret
WECOM_SECRET=your_app_secret

# 回调 Token
WECOM_TOKEN=your_callback_token

# EncodingAESKey
WECOM_ENCODING_AES_KEY=your_encoding_aes_key

# 回调 URL（自动生成）
WECOM_CALLBACK_URL=https://${DOMAIN}/api/wecom/callback

#------------------------------------------------------------------------------
# Telegram Bot 配置（可选）
#------------------------------------------------------------------------------
# 如需启用 Telegram Bot 支持，请填写以下配置
# 1. 通过 @BotFather 创建 Bot 并获取 Token
# 2. 生成一个随机字符串作为 Webhook Secret（openssl rand -hex 32）
# 3. 配置 Webhook URL：https://${DOMAIN}/telegram/webhook
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

#------------------------------------------------------------------------------
# 虚拟员工配置
#------------------------------------------------------------------------------
# 启用的虚拟员工角色（逗号分隔）
AGENTS_ENABLED=dispatcher,operation,product,development,testing,service

# 调度员配置
AGENT_DISPATCHER_NAME=智能调度员
AGENT_DISPATCHER_ROLE=dispatcher

# 运营专员配置
AGENT_OPERATION_NAME=运营专员小张
AGENT_OPERATION_ROLE=operation

# 产品经理配置
AGENT_PRODUCT_NAME=产品经理小李
AGENT_PRODUCT_ROLE=product

# 开发工程师配置
AGENT_DEVELOPMENT_NAME=开发工程师小王
AGENT_DEVELOPMENT_ROLE=development

# 测试工程师配置
AGENT_TESTING_NAME=测试工程师小刘
AGENT_TESTING_ROLE=testing

# 客服专员配置
AGENT_SERVICE_NAME=客服专员小陈
AGENT_SERVICE_ROLE=service

#------------------------------------------------------------------------------
# 日志配置
#------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=/logs
LOG_MAX_SIZE=100M
LOG_MAX_FILES=30

#------------------------------------------------------------------------------
# 性能配置
#------------------------------------------------------------------------------
# 最大并发任务数
MAX_CONCURRENT_TASKS=50

# 任务超时（秒）
TASK_TIMEOUT=600

# 缓存过期时间（秒）
CACHE_TTL=7200

# 连接池大小
DB_POOL_SIZE=20

#------------------------------------------------------------------------------
# 监控配置（可选）
#------------------------------------------------------------------------------
# Prometheus 监控
ENABLE_METRICS=true
METRICS_PORT=9090

# 健康检查
HEALTH_CHECK_INTERVAL=60

#------------------------------------------------------------------------------
# 备份配置
#------------------------------------------------------------------------------
# 自动备份
ENABLE_AUTO_BACKUP=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/opt/openclaw/backups

#------------------------------------------------------------------------------
# 邮件通知配置（可选）
#------------------------------------------------------------------------------
# SMTP 配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@example.com

# 管理员邮箱（接收告警）
# ADMIN_EMAIL=admin@example.com

#------------------------------------------------------------------------------
# 高级配置
#------------------------------------------------------------------------------
# 调试模式（生产环境请设置为 false）
DEBUG=false
VERBOSE=false

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Session 配置
SESSION_SECRET=${SECRET_KEY}
SESSION_MAX_AGE=86400000

#==============================================================================
# 配置检查清单
#==============================================================================
# 
# 必须修改的配置：
# ✅ SECRET_KEY - 生成随机字符串
# ✅ GITHUB_TOKEN 或 OPENAI_API_KEY - 填入 API Key
# ✅ WECOM_* - 填入企业微信配置
# ✅ DOMAIN - 填入你的域名
#
# 可选配置：
# - DATABASE_URL - 如需使用 PostgreSQL
# - SMTP_* - 如需邮件通知
# - ADMIN_EMAIL - 接收告警邮件
#
# 安全提示：
# ⚠️  不要将此文件提交到 Git
# ⚠️  SECRET_KEY 必须是随机生成的
# ⚠️  数据库密码必须足够强
# ⚠️  定期更新 API Key 和密钥
#
#==============================================================================
