[Unit]
Description=OpenClaw Gateway (Flask + Dispatcher)
After=network.target docker.service
Wants=docker.service

[Service]
Type=forking
User=root
EnvironmentFile=/opt/openclaw/production/.env.prod
ExecStart=/opt/openclaw/scripts/start-gateway.sh
ExecStop=/opt/openclaw/scripts/stop-gateway.sh
Restart=on-failure
RestartSec=10
PIDFile=/tmp/openclaw/flask.pid

[Install]
WantedBy=multi-user.target
