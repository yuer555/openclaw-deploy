# OpenClaw 企业微信虚拟员工 - 环境变量配置

# ==========================================
# 企业微信配置
# ==========================================
# 获取方式：企业微信管理后台 → 应用管理 → 自建应用
# 详细步骤见：docs/04-企业微信配置.md

# 企业ID（必需）
WECOM_CORP_ID=your_corp_id_here

# 应用Secret（必需）
WECOM_SECRET=your_secret_here

# 应用ID（必需）
WECOM_AGENT_ID=1000002

# Token（消息验证，必需）
# 生成方式：随机字符串，3-32位字母+数字
WECOM_TOKEN=your_token_here

# EncodingAESKey（消息加密，必需）
# 生成方式：随机字符串，43位Base64字符
WECOM_ENCODING_AES_KEY=your_encoding_aes_key_43_chars_here

# ==========================================
# Telegram Bot 配置（可选）
# ==========================================
# 获取方式：通过 @BotFather 创建 Bot
# 详细步骤见：docs/11-Telegram配置.md

# Bot Token（必需）
# 获取方式：@BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook Secret（必需）
# 生成方式：openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# OpenClaw Gateway 配置
# ==========================================
# OpenClaw Gateway API 地址
OPENCLAW_GATEWAY_URL=http://localhost:18789

# OpenClaw API Key（如果启用了认证）
OPENCLAW_API_KEY=

# OpenClaw API 超时时间（秒）
OPENCLAW_TIMEOUT=30

# ==========================================
# Anthropic API 配置
# ==========================================
# 获取方式：https://console.anthropic.com/settings/keys
# 注意：需要有充足余额

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# 数据库配置
# ==========================================
# 数据库文件路径（SQLite）
DB_PATH=/data/user_roles.db

# PostgreSQL 配置（可选，用于高并发场景）
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=openclaw_wecom
# DB_USER=openclaw
# DB_PASSWORD=your_db_password_here

# ==========================================
# 监控配置
# ==========================================
# Grafana 管理员密码
GRAFANA_PASSWORD=your_grafana_password_here

# Prometheus 保留时间（天）
PROMETHEUS_RETENTION=30

# ==========================================
# 其他配置
# ==========================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai

# 服务端口
GATEWAY_PORT=8000

# ==========================================
# 安全配置
# ==========================================
# API 速率限制（每分钟请求数）
RATE_LIMIT=60

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# 最大消息长度（字节）
MAX_MESSAGE_LENGTH=2048
