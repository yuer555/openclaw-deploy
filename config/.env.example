# OpenClaw 企业微信虚拟员工 - 环境变量配置

# =your_value_here
# 企业微信配置
# =your_value_here
# 获取方式：企业微信管理后台 → 应用管理 → 自建应用
# 详细步骤见：企业微信应用配置指南.md

# Token（消息验证）
WECOM_TOKEN=your_value_here

# EncodingAESKey（消息加密）
WECOM_ENCODING_AES_KEY=your_value_here

# 企业ID
WECOM_CORPID=your_value_here

# 应用Secret
WECOM_CORPSECRET=your_value_here

# 应用ID（可选）
WECOM_AGENTID=your_value_here

# =your_value_here
# Anthropic API 配置
# =your_value_here
# 获取方式：https://console.anthropic.com/settings/keys
# 注意：需要有充足余额

ANTHROPIC_API_KEY=your_value_here

# =your_value_here
# 监控配置
# =your_value_here
# Grafana 管理员密码
GRAFANA_PASSWORD=your_value_here

# =your_value_here
# 数据库配置（可选，默认使用 SQLite）
# =your_value_here
DB_TYPE=your_value_here
# DB_HOST=your_value_here
# DB_PORT=your_value_here
# DB_NAME=your_value_here
# DB_USER=your_value_here
# DB_PASSWORD=your_value_here

# =your_value_here
# 其他配置
# =your_value_here
# 日志级别
LOG_LEVEL=your_value_here

# 时区
TZ=your_value_here
