FROM node:24

# 设置标签
LABEL maintainer="OpenClaw Team"
LABEL description="OpenClaw Virtual Agent - Pre-built with all dependencies"
LABEL version="2.0"

# 构建参数：角色名称（operation/product/development/testing/service）
ARG ROLE=service

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 配置 Git
RUN git config --global url.'https://github.com/'.insteadOf 'ssh://git@github.com/' && \
    git config --global http.postBuffer 524288000 && \
    git config --global http.timeout 300

# 配置 npm 国内镜像
RUN npm config set registry https://registry.npmmirror.com

# 安装 OpenClaw
RUN npm install -g openclaw@latest

# 设置工作目录
WORKDIR /workspace

# 预置角色性格（通过 build arg 选择对应 CLAUDE.md）
COPY agents/workspace/${ROLE}.md /workspace/CLAUDE.md

# 暴露端口
EXPOSE 18789

# 启动命令
CMD ["npx", "openclaw", "gateway", "--allow-unconfigured"]

