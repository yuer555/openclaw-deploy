FROM openclaw-base:latest

LABEL description="OpenClaw Virtual Agent"

# 构建参数：角色名称（operation/product/development/testing/service/dispatcher）
ARG ROLE=service

# 预置角色 workspace 文件到 openclaw workspace 目录
RUN mkdir -p /root/.openclaw/workspace
COPY config/agents/workspace/${ROLE}/ /root/.openclaw/workspace/

# 将 IDENTITY.md 设为只读，防止 AI 修改安全约束
# 配合 prompt 中"禁止修改此文件"的约束，形成双重防护
RUN chmod 444 /root/.openclaw/workspace/IDENTITY.md

# 设置工作目录
WORKDIR /root/.openclaw/workspace

# 暴露端口
EXPOSE 18789

# 启动时：配置 API（OPENAI_API_KEY 优先）、启动 gateway
# 支持 MODEL_PROVIDER 自定义 provider 名（避免与 openclaw 内置 provider 冲突）
# 支持 MODEL_API 指定 API 协议格式（默认 openai-responses）
CMD ["sh", "-c", "\
  mkdir -p /root/.openclaw/agents/main/agent && \
  INTERNAL_TOKEN=\"${OPENCLAW_INTERNAL_TOKEN:-openclaw-internal-secret}\" && \
  PROVIDER=\"${MODEL_PROVIDER:-anthropic}\" && \
  API_FORMAT=\"${MODEL_API:-openai-responses}\" && \
  if [ -n \"$OPENAI_API_KEY\" ]; then \
    printf '{\"agents\":{\"defaults\":{\"model\":{\"primary\":\"openai/gpt-4o\"},\"models\":{\"openai/gpt-4o\":{}}}},\"gateway\":{\"bind\":\"lan\",\"auth\":{\"mode\":\"token\",\"token\":\"%s\"},\"http\":{\"endpoints\":{\"responses\":{\"enabled\":true}}},\"controlUi\":{\"dangerouslyAllowHostHeaderOriginFallback\":true}}}' \"$INTERNAL_TOKEN\" > /root/.openclaw/openclaw.json; \
  elif [ -n \"$API_BASE_URL\" ] && [ -n \"$API_KEY\" ]; then \
    MODEL=${MODEL_NAME:-claude-sonnet-4-20250514} && \
    printf '{\"providers\":{\"%s\":{\"baseUrl\":\"%s\",\"apiKey\":\"%s\",\"auth\":\"api-key\",\"api\":\"%s\",\"authHeader\":true,\"models\":[{\"id\":\"%s\",\"name\":\"%s\"}]}}}' \"$PROVIDER\" \"$API_BASE_URL\" \"$API_KEY\" \"$API_FORMAT\" \"$MODEL\" \"$MODEL\" > /root/.openclaw/agents/main/agent/models.json && \
    printf '{\"version\":1,\"profiles\":{\"%s:default\":{\"type\":\"api_key\",\"provider\":\"%s\",\"key\":\"%s\"}}}' \"$PROVIDER\" \"$PROVIDER\" \"$API_KEY\" > /root/.openclaw/agents/main/agent/auth-profiles.json && \
    printf '{\"agents\":{\"defaults\":{\"model\":{\"primary\":\"%s/%s\"},\"models\":{\"%s/%s\":{}}}},\"gateway\":{\"bind\":\"lan\",\"auth\":{\"mode\":\"token\",\"token\":\"%s\"},\"http\":{\"endpoints\":{\"responses\":{\"enabled\":true}}},\"controlUi\":{\"dangerouslyAllowHostHeaderOriginFallback\":true}}}' \"$PROVIDER\" \"$MODEL\" \"$PROVIDER\" \"$MODEL\" \"$INTERNAL_TOKEN\" > /root/.openclaw/openclaw.json; \
  fi && \
  cd /root/.openclaw/workspace && \
  npx openclaw gateway --allow-unconfigured --bind lan"]

