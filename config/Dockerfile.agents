FROM node:24

# 设置标签
LABEL maintainer="OpenClaw Team"
LABEL description="OpenClaw Virtual Agent - Pre-built with all dependencies"
LABEL version="2.0"

# 构建参数：角色名称（operation/product/development/testing/service）
ARG ROLE=service

# 换用国内 debian 镜像源
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 配置 Git
RUN git config --global url.'https://github.com/'.insteadOf 'ssh://git@github.com/' && \
    git config --global http.postBuffer 524288000 && \
    git config --global http.timeout 300

# 配置 npm 国内镜像
RUN npm config set registry https://registry.npmmirror.com

# 安装 OpenClaw
RUN npm install -g openclaw@latest

# 预置角色 workspace 文件到 openclaw workspace 目录
RUN mkdir -p /root/.openclaw/workspace
COPY config/agents/workspace/${ROLE}/ /root/.openclaw/workspace/

# 将 IDENTITY.md 设为只读，防止 AI 修改安全约束
# 配合 prompt 中"禁止修改此文件"的约束，形成双重防护
RUN chmod 444 /root/.openclaw/workspace/IDENTITY.md

# 设置工作目录
WORKDIR /root/.openclaw/workspace

# 暴露端口
EXPOSE 18789

# 启动时：配置 API（OPENAI_API_KEY 优先）、启动 gateway
CMD ["sh", "-c", "\
  mkdir -p /root/.openclaw/agents/main/agent && \
  if [ -n \"$OPENAI_API_KEY\" ]; then \
    printf '{\"agents\":{\"defaults\":{\"model\":{\"primary\":\"openai/gpt-4o\"},\"models\":{\"openai/gpt-4o\":{}}}},\"gateway\":{\"bind\":\"lan\",\"controlUi\":{\"dangerouslyAllowHostHeaderOriginFallback\":true}}}' > /root/.openclaw/openclaw.json; \
  elif [ -n \"$API_BASE_URL\" ] && [ -n \"$API_KEY\" ]; then \
    MODEL=${MODEL_NAME:-claude-sonnet-4-20250514} && \
    printf '{\"providers\":{\"anthropic\":{\"baseUrl\":\"%s\",\"models\":[]}}}' \"$API_BASE_URL\" > /root/.openclaw/agents/main/agent/models.json && \
    printf '{\"profiles\":{\"anthropic:manual\":{\"provider\":\"anthropic\",\"kind\":\"apiKey\",\"apiKey\":\"%s\",\"label\":\"third-party\"}}}' \"$API_KEY\" > /root/.openclaw/agents/main/agent/auth-profiles.json && \
    printf '{\"agents\":{\"defaults\":{\"model\":{\"primary\":\"anthropic/%s\"},\"models\":{\"anthropic/%s\":{}}}},\"gateway\":{\"bind\":\"lan\",\"controlUi\":{\"dangerouslyAllowHostHeaderOriginFallback\":true}}}' \"$MODEL\" \"$MODEL\" > /root/.openclaw/openclaw.json && \
    export ANTHROPIC_API_KEY=\"$API_KEY\"; \
  fi && \
  cd /root/.openclaw/workspace && \
  npx openclaw gateway --allow-unconfigured --bind lan"]

